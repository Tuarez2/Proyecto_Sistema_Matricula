{
  "name": "sistema-matricula-universitaria-backend",
  "version": "1.0.0",
  "description": "Backend inicial para un Sistema de Matricula Universitaria.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate --config src/config/config.cjs --migrations-path src/database/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/config.cjs --migrations-path src/database/migrations",
    "db:seed": "sequelize-cli db:seed:all --config src/config/config.cjs --seeders-path src/database/seeders",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config src/config/config.cjs --seeders-path src/database/seeders"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  }
}
