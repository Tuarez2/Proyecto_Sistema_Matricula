{
  "name": "sistema-matricula-universitaria-backend",
  "version": "1.0.0",
  "description": "Backend en Node.js, Express, JavaScript, Sequelize 6 y MySQL para el Sistema de Matricula Universitaria.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "sequelize-cli db:migrate --config src/config/sequelize-cli.cjs --migrations-path migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/sequelize-cli.cjs --migrations-path migrations",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config src/config/sequelize-cli.cjs --migrations-path migrations",
    "db:seed": "sequelize-cli db:seed:all --config src/config/sequelize-cli.cjs --seeders-path seeders",
    "db:seed:undo": "sequelize-cli db:seed:undo --config src/config/sequelize-cli.cjs --seeders-path seeders",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all --config src/config/sequelize-cli.cjs --seeders-path seeders"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
