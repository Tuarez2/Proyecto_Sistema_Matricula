{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rootDirectory": "frontend",
  "buildCommand": "node scripts/configurar-api.mjs && npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}